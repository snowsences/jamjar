// Publish this complete ruleset in the jamjar-ec8c6 Firebase project.
// Only the two Jamjar members' Firebase Auth UIDs can access Jamjar.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isJamjarMember() {
      return request.auth != null
        && request.auth.uid in [
          'YR6zFUL4msfoxOuvO741uLv5aWB3',
          '7juHFkuegjghBUyCRaRbTPtu9P93'
        ];
    }

    match /jamjarHouseholds/shared/items/{itemId} {
      allow read, write: if isJamjarMember();
    }

    match /jamjarHouseholds/shared/history/{historyId} {
      allow read: if isJamjarMember();

      allow create: if isJamjarMember()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorEmail == request.auth.token.email;

      allow update, delete: if false;
    }
  }
}
